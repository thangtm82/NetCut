<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NetCut.Controls"
             x:Class="NetCut.MainPage"
             Title="NetCut"
             BackgroundColor="#15171B">
  <Grid RowDefinitions="Auto,*,220,Auto" Padding="14" RowSpacing="12">
    <HorizontalStackLayout Spacing="10" Grid.Row="0">
      <Label Text="NETCUT" FontSize="26" FontAttributes="Bold" TextColor="#F5F7FA" VerticalOptions="Center"/>
      <Button Text="New" Clicked="OnNewClicked"/>
      <Button Text="Open Project" Clicked="OnOpenClicked"/>
      <Button Text="Save Project" Clicked="OnSaveClicked"/>
      <Button Text="Undo" Clicked="OnUndoClicked"/>
      <Button Text="Redo" Clicked="OnRedoClicked"/>
      <Button Text="Import Media" Clicked="OnImportClicked"/>
      <Button x:Name="ExportButton" Text="Export MP4" Clicked="OnExportClicked"/>
      <Button x:Name="CancelExportButton" Text="Cancel Export" Clicked="OnCancelExportClicked" IsEnabled="False"/>
    </HorizontalStackLayout>

    <Grid Grid.Row="1" ColumnDefinitions="290,*,300" ColumnSpacing="12">
      <Border Grid.Column="0" BackgroundColor="#24272E" StrokeThickness="0" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Label Text="PROJECT MEDIA" TextColor="White" FontAttributes="Bold"/>
          <CollectionView x:Name="MediaList" Grid.Row="1" SelectionMode="Single">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8">
                  <Label Text="{Binding Name}" TextColor="#E4E8EF" LineBreakMode="TailTruncation"/>
                </Grid>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </Grid>
      </Border>

      <Border Grid.Column="1" BackgroundColor="#0B0D10" StrokeThickness="0" Padding="16">
        <VerticalStackLayout Spacing="12">
          <Label Text="PREVIEW" TextColor="#B8C0CB" FontAttributes="Bold"/>
          <controls:NativeVideoView x:Name="VideoPreview" HeightRequest="260" />
          <Image x:Name="CompositedFrame" HeightRequest="260" IsVisible="False" Aspect="AspectFit"/>
          <Button Text="Render Composite Frame" Clicked="OnRenderFrameClicked"/>
          <Button x:Name="PreviewSegmentButton" Text="Play 5s Composed Preview" Clicked="OnPreviewSegmentClicked"/>
          <Button x:Name="ContinuousPreviewButton" Text="Play Full Timeline (Cached)" Clicked="OnContinuousPreviewClicked"/>
          <Button Text="Stop Preview" Clicked="OnStopContinuousPreviewClicked"/>
          <Button Text="Play Cached Chunks" Clicked="OnPlayChunksClicked"/>
          <Button Text="Stop Chunks" Clicked="OnStopChunksClicked"/>
          <HorizontalStackLayout Spacing="8">
            <Button Text="Play" Clicked="OnPlayClicked"/>
            <Button Text="Pause" Clicked="OnPauseClicked"/>
            <Button Text="Seek" Clicked="OnSeekClicked"/>
          </HorizontalStackLayout>
          <Slider x:Name="PlayheadSlider" Minimum="0" Maximum="1" ValueChanged="OnPlayheadChanged"/>
          <Label x:Name="PlayheadLabel" Text="00:00 / 00:00" TextColor="White"/>
          <Label x:Name="ProjectNameLabel" Text="Untitled Project" FontSize="21" TextColor="White"
                 HorizontalTextAlignment="Center"/>
          <Button Text="Add Selected Media to Timeline" Clicked="OnAddClipClicked"/>
        </VerticalStackLayout>
      </Border>

      <Border Grid.Column="2" BackgroundColor="#24272E" StrokeThickness="0" Padding="12">
        <VerticalStackLayout Spacing="10">
          <Label Text="CLIP INSPECTOR" TextColor="White" FontAttributes="Bold"/>
          <Label Text="In point (seconds)" TextColor="White"/>
          <Entry x:Name="InEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Label Text="Out point (seconds)" TextColor="White"/>
          <Entry x:Name="OutEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Button Text="Apply Trim to Selected Clip" Clicked="OnApplyTrimClicked"/>
          <Button Text="Split Selected Clip" Clicked="OnSplitClicked"/>
          <Button Text="Remove Clip" Clicked="OnRemoveClipClicked"/>
          <Label Text="Track (0 = V1)" TextColor="White"/>
          <Entry x:Name="TrackEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Button Text="Move to Track" Clicked="OnMoveTrackClicked"/>
        </VerticalStackLayout>
      </Border>
    </Grid>

    <Border Grid.Row="2" BackgroundColor="#24272E" StrokeThickness="0" Padding="12">
      <Grid RowDefinitions="Auto,*" RowSpacing="6">
        <HorizontalStackLayout Spacing="10"><Label Text="TIMELINE (CLIPS)" TextColor="White" FontAttributes="Bold"/><CheckBox x:Name="RippleCheckBox"/><Label Text="Ripple" TextColor="White"/><Label Text="Zoom" TextColor="White"/><Slider x:Name="TimelineZoomSlider" Minimum="15" Maximum="120" Value="35" WidthRequest="180" ValueChanged="OnTimelineZoomChanged"/><Button Text="Ripple Delete" Clicked="OnRippleDeleteClicked"/></HorizontalStackLayout>
        <CollectionView x:Name="TimelineList" Grid.Row="1" HeightRequest="60" SelectionMode="Single" SelectionChanged="OnTimelineSelectionChanged">
          <CollectionView.ItemTemplate>
            <DataTemplate>
              <Border BackgroundColor="#166F61" Padding="12" Margin="2">
                <Label Text="{Binding Name}" TextColor="White"/>
              </Border>
            </DataTemplate>
          </CollectionView.ItemTemplate>
        </CollectionView>
        <ScrollView Orientation="Horizontal" Grid.Row="1" Margin="0,65,0,0">
          <controls:TimelineCanvas x:Name="TimelineCanvas" WidthRequest="4000"/>
        </ScrollView>
      </Grid>
    </Border>

    <VerticalStackLayout Grid.Row="3" Spacing="3">
      <ProgressBar x:Name="ExportProgressBar" Progress="0"/>
      <Label x:Name="StatusLabel" Text="Ready" TextColor="#C9D2DB"/>
    </VerticalStackLayout>
  </Grid>
</ContentPage>
