<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NetCut.Controls"
             x:Class="NetCut.MainPage"
             Title="NetCut"
             BackgroundColor="#F7F8FA">
  <Grid RowDefinitions="48,*,205,Auto" Padding="0" RowSpacing="0">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" BackgroundColor="#FFFFFF" Padding="14,4" ColumnSpacing="12">
      <HorizontalStackLayout Grid.Column="0" Spacing="9" VerticalOptions="Center">
        <Label Text="❮" TextColor="#28323D" FontSize="18" VerticalTextAlignment="Center"/>
        <Label Text="♞" TextColor="#13202E" FontSize="23" FontAttributes="Bold" VerticalTextAlignment="Center"/>
        <Label x:Name="ProjectNameHeader" Text="Untitled Project" FontSize="14" FontAttributes="Bold" TextColor="#18212B" VerticalTextAlignment="Center"/>
        <Label x:Name="SaveStateLabel" Text="✓ Saved" FontSize="11" TextColor="#83909C" VerticalTextAlignment="Center"/>
      </HorizontalStackLayout>
      <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
        <Button Text="New" Clicked="OnNewClicked" FontSize="12" BackgroundColor="Transparent" TextColor="#263442" Padding="8,2"/>
        <Button Text="Open" Clicked="OnOpenClicked" FontSize="12" BackgroundColor="Transparent" TextColor="#263442" Padding="8,2"/>
        <Button Text="Save" Clicked="OnSaveClicked" FontSize="12" BackgroundColor="Transparent" TextColor="#263442" Padding="8,2"/>
        <Button Text="Undo" Clicked="OnUndoClicked" FontSize="12" BackgroundColor="Transparent" TextColor="#263442" Padding="8,2"/>
        <Button Text="Redo" Clicked="OnRedoClicked" FontSize="12" BackgroundColor="Transparent" TextColor="#263442" Padding="8,2"/>
        <Button x:Name="ExportButton" Text="⇧ Export" Clicked="OnExportClicked" FontSize="12" BackgroundColor="#EBF2FB" TextColor="#194B8B" Padding="11,3"/>
        <Button x:Name="CancelExportButton" Text="Cancel" Clicked="OnCancelExportClicked" IsEnabled="False" FontSize="12" BackgroundColor="#F2F3F5" TextColor="#6C7784" Padding="8,2"/>
      </HorizontalStackLayout>
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="52,254,*,300" ColumnSpacing="8">
      <Border Grid.Column="0" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="2">
        <ScrollView VerticalScrollBarVisibility="Never"><VerticalStackLayout Spacing="3">
          <Button Text="▣" Clicked="OnShowMediaPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Media" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="◇" Clicked="OnShowElementsPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Elements" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="✦" Clicked="OnShowEffectsPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Effects" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="◉" Clicked="OnShowTransitionsPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Transitions" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="▤" Clicked="OnShowVideoPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Video" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="▧" Clicked="OnShowImagePanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Image" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="♫" Clicked="OnShowAudioPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Audio" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="▣" Clicked="OnShowSubtitlesPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Subtitles" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
          <Button Text="☷" Clicked="OnShowDetailsPanelClicked" BackgroundColor="Transparent" TextColor="#394754" FontSize="17" Padding="0" HeightRequest="32"/>
          <Label Text="Details" FontSize="9" TextColor="#495464" HorizontalTextAlignment="Center" Margin="0,0,0,7"/>
        </VerticalStackLayout></ScrollView>
      </Border>
      <Border Grid.Column="1" BackgroundColor="#FFFFFF" StrokeThickness="0" Padding="10">
        <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
          <Label x:Name="SidebarTitle" Text="Media" FontSize="17" TextColor="#1E2935" FontAttributes="Bold"/>
          <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="5">
            <Button x:Name="ProjectFilesTab" Text="Project Files" Clicked="OnProjectFilesTabClicked" BackgroundColor="#E8EBF1" TextColor="#263544" Padding="4" FontSize="11"/>
            <Button x:Name="LibraryTab" Grid.Column="1" Text="Library" Clicked="OnLibraryTabClicked" BackgroundColor="#F2F3F6" TextColor="#5A6979" Padding="4" FontSize="11"/>
          </Grid>
          <Button x:Name="SidebarImportButton" Grid.Row="2" Text="⇧ Upload" Clicked="OnImportClicked" BackgroundColor="#F3F5F8" TextColor="#223345" FontAttributes="Bold"/>
          <Grid Grid.Row="3">
            <CollectionView x:Name="MediaList" SelectionMode="Single">
              <CollectionView.EmptyView>
                <Label Text="No imported media yet. Use Import Media to add files." TextColor="#9BA8B8" FontSize="12" Margin="6,14"/>
              </CollectionView.EmptyView>
              <CollectionView.ItemTemplate>
                <DataTemplate>
                  <Border BackgroundColor="#F3F5F8" StrokeThickness="0" Padding="8" Margin="0,3">
                    <Grid>
                      <Grid.GestureRecognizers><DragGestureRecognizer CanDrag="True" DragStarting="OnMediaDragStarting"/></Grid.GestureRecognizers>
                      <Label Text="{Binding Name}" TextColor="#253443" FontSize="12" LineBreakMode="TailTruncation"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </CollectionView.ItemTemplate>
            </CollectionView>
            <Label x:Name="LibraryPlaceholder" Text="Library will show reusable assets. Imported files remain in Project Files." IsVisible="False" TextColor="#B5C1D0" FontSize="12" Margin="6,14"/>
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="2" BackgroundColor="#0B0D10" StrokeThickness="0" Padding="16">
        <VerticalStackLayout Spacing="12">
          <Label Text="PREVIEW" TextColor="#B8C0CB" FontAttributes="Bold"/>
          <controls:NativeVideoView x:Name="VideoPreview" HeightRequest="260" />
          <Image x:Name="CompositedFrame" HeightRequest="260" IsVisible="False" Aspect="AspectFit"/>
          <Button Text="Render Composite Frame" Clicked="OnRenderFrameClicked"/>
          <Button x:Name="PreviewSegmentButton" Text="Play 5s Composed Preview" Clicked="OnPreviewSegmentClicked"/>
          <Button x:Name="ContinuousPreviewButton" Text="Play Full Timeline (Cached)" Clicked="OnContinuousPreviewClicked"/>
          <Button Text="Stop Preview" Clicked="OnStopContinuousPreviewClicked"/>
          <Button Text="Play Cached Chunks" Clicked="OnPlayChunksClicked"/>
          <Button Text="Stop Chunks" Clicked="OnStopChunksClicked"/>
          <HorizontalStackLayout Spacing="8">
            <Button Text="Play" Clicked="OnPlayClicked"/>
            <Button Text="Pause" Clicked="OnPauseClicked"/>
            <Button Text="Seek" Clicked="OnSeekClicked"/>
          </HorizontalStackLayout>
          <Slider x:Name="PlayheadSlider" Minimum="0" Maximum="1" ValueChanged="OnPlayheadChanged"/>
          <Label x:Name="PlayheadLabel" Text="00:00 / 00:00" TextColor="White"/>
          <Label x:Name="ProjectNameLabel" Text="Untitled Project" FontSize="21" TextColor="White"
                 HorizontalTextAlignment="Center"/>
          <Button Text="Add Selected Media to Timeline" Clicked="OnAddClipClicked"/>
        </VerticalStackLayout>
      </Border>

      <Border Grid.Column="3" BackgroundColor="#24272E" StrokeThickness="0" Padding="12">
        <VerticalStackLayout Spacing="10">
          <Label Text="CLIP INSPECTOR" TextColor="White" FontAttributes="Bold"/>
          <Label Text="In point (seconds)" TextColor="White"/>
          <Entry x:Name="InEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Label Text="Out point (seconds)" TextColor="White"/>
          <Entry x:Name="OutEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Button Text="Apply Trim to Selected Clip" Clicked="OnApplyTrimClicked"/>
          <Button Text="Split Selected Clip" Clicked="OnSplitClicked"/>
          <Button Text="Remove Clip" Clicked="OnRemoveClipClicked"/>
          <Label Text="Track (0 = V1)" TextColor="White"/>
          <Entry x:Name="TrackEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Button Text="Move to Track" Clicked="OnMoveTrackClicked"/>
        </VerticalStackLayout>
      </Border>
    </Grid>

    <Border Grid.Row="2" BackgroundColor="#F7F8FA" StrokeThickness="0" Padding="0">
      <Grid RowDefinitions="36,28,*" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,0" BackgroundColor="#FFFFFF">
          <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
            <Label Text="Main ▾" TextColor="#171C26" FontAttributes="Bold" VerticalTextAlignment="Center"/>
            <Button Text="T" Clicked="OnSubtitleToolClicked" Padding="6,0" BackgroundColor="Transparent" TextColor="#222B35"/>
            <Button Text="✂" Clicked="OnSplitAtPlayheadClicked" Padding="6,0" BackgroundColor="Transparent" TextColor="#222B35"/>
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Button Text="|◀" Clicked="OnTimelineBeginningClicked" Padding="4,0" BackgroundColor="Transparent" TextColor="#20242A"/>
            <Button x:Name="TimelinePlayButton" Text="▶" Clicked="OnTimelinePlayPauseClicked" Padding="8,0" BackgroundColor="#15191F" TextColor="White"/>
            <Label x:Name="TimelineTimeLabel" Text="0:00.00 / 0:00.00" TextColor="#25364B" FontSize="12" VerticalTextAlignment="Center"/>
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            <Label Text="Zoom" TextColor="#364152" VerticalTextAlignment="Center"/>
            <Slider x:Name="TimelineZoomSlider" Minimum="1" Maximum="80" Value="4" WidthRequest="130" ValueChanged="OnTimelineZoomChanged"/>
            <Button Text="Fit" Clicked="OnTimelineFitClicked" Padding="8,0" BackgroundColor="#E8EDF3" TextColor="#25364B"/>
            <CheckBox x:Name="RippleCheckBox" Color="#248CF5"/>
            <Label Text="Ripple" TextColor="#364152" VerticalTextAlignment="Center"/>
            <Button Text="Waveform" Clicked="OnBuildWaveformsClicked" Padding="7,0" BackgroundColor="#E8EDF3" TextColor="#25364B"/>
            <Button Text="Ripple Delete" Clicked="OnRippleDeleteClicked" Padding="7,0" BackgroundColor="#E8EDF3" TextColor="#25364B"/>
          </HorizontalStackLayout>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="26,*" BackgroundColor="#FFFFFF">
          <Label Grid.Column="0" Text="☰" TextColor="#7A8390" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
          <Label Grid.Column="1" Text="Drag clips • trim edges • click ruler to seek" FontSize="10" TextColor="#7C8793" VerticalTextAlignment="Center" Margin="4,0"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="26,*" BackgroundColor="#F4F5F7">
          <CollectionView x:Name="TimelineList" IsVisible="False" SelectionMode="Single" SelectionChanged="OnTimelineSelectionChanged" />
          <Grid Grid.Column="0" RowDefinitions="26,60,28,28" BackgroundColor="#F0F2F5">
            <Label Grid.Row="0" Text="◉" TextColor="#77818E" HorizontalTextAlignment="Center"/>
            <Label Grid.Row="1" Text="◉" TextColor="#697685" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
            <Label Grid.Row="2" Text="♫" TextColor="#697685" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
            <Label Grid.Row="3" Text="T" TextColor="#697685" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
          </Grid>
          <Grid x:Name="TimelineViewport" Grid.Column="1" RowDefinitions="*,18" SizeChanged="OnTimelineViewportSizeChanged">
            <controls:TimelineCanvas x:Name="TimelineCanvas" Grid.Row="0" HorizontalOptions="Fill" VerticalOptions="Fill">
              <controls:TimelineCanvas.GestureRecognizers><DropGestureRecognizer AllowDrop="True" Drop="OnMediaDropped"/></controls:TimelineCanvas.GestureRecognizers>
            </controls:TimelineCanvas>
            <Slider x:Name="TimelinePanSlider" Grid.Row="1" Minimum="0" Maximum="1" ValueChanged="OnTimelinePanChanged" />
          </Grid>
        </Grid>
      </Grid>
    </Border>

    <VerticalStackLayout Grid.Row="3" Spacing="3">
      <ProgressBar x:Name="ExportProgressBar" Progress="0"/>
      <Label x:Name="StatusLabel" Text="Ready" TextColor="#C9D2DB"/>
    </VerticalStackLayout>
  </Grid>
</ContentPage>
