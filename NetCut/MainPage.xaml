<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:NetCut.Controls"
             x:Class="NetCut.MainPage"
             Title="NetCut"
             BackgroundColor="#15171B">
  <Grid RowDefinitions="Auto,*,205,Auto" Padding="14" RowSpacing="12">
    <HorizontalStackLayout Spacing="10" Grid.Row="0">
      <Label Text="NETCUT" FontSize="26" FontAttributes="Bold" TextColor="#F5F7FA" VerticalOptions="Center"/>
      <Button Text="New" Clicked="OnNewClicked"/>
      <Button Text="Open Project" Clicked="OnOpenClicked"/>
      <Button Text="Save Project" Clicked="OnSaveClicked"/>
      <Button Text="Undo" Clicked="OnUndoClicked"/>
      <Button Text="Redo" Clicked="OnRedoClicked"/>
      <Button Text="Import Media" Clicked="OnImportClicked"/>
      <Button x:Name="ExportButton" Text="Export MP4" Clicked="OnExportClicked"/>
      <Button x:Name="CancelExportButton" Text="Cancel Export" Clicked="OnCancelExportClicked" IsEnabled="False"/>
    </HorizontalStackLayout>

    <Grid Grid.Row="1" ColumnDefinitions="290,*,300" ColumnSpacing="12">
      <Border Grid.Column="0" BackgroundColor="#24272E" StrokeThickness="0" Padding="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
          <Label Text="PROJECT MEDIA" TextColor="White" FontAttributes="Bold"/>
          <CollectionView x:Name="MediaList" Grid.Row="1" SelectionMode="Single">
            <CollectionView.ItemTemplate>
              <DataTemplate>
                <Grid Padding="8">
                  <Grid.GestureRecognizers><DragGestureRecognizer CanDrag="True" DragStarting="OnMediaDragStarting"/></Grid.GestureRecognizers>
                  <Label Text="{Binding Name}" TextColor="#E4E8EF" LineBreakMode="TailTruncation"/>
                </Grid>
              </DataTemplate>
            </CollectionView.ItemTemplate>
          </CollectionView>
        </Grid>
      </Border>

      <Border Grid.Column="1" BackgroundColor="#0B0D10" StrokeThickness="0" Padding="16">
        <VerticalStackLayout Spacing="12">
          <Label Text="PREVIEW" TextColor="#B8C0CB" FontAttributes="Bold"/>
          <controls:NativeVideoView x:Name="VideoPreview" HeightRequest="260" />
          <Image x:Name="CompositedFrame" HeightRequest="260" IsVisible="False" Aspect="AspectFit"/>
          <Button Text="Render Composite Frame" Clicked="OnRenderFrameClicked"/>
          <Button x:Name="PreviewSegmentButton" Text="Play 5s Composed Preview" Clicked="OnPreviewSegmentClicked"/>
          <Button x:Name="ContinuousPreviewButton" Text="Play Full Timeline (Cached)" Clicked="OnContinuousPreviewClicked"/>
          <Button Text="Stop Preview" Clicked="OnStopContinuousPreviewClicked"/>
          <Button Text="Play Cached Chunks" Clicked="OnPlayChunksClicked"/>
          <Button Text="Stop Chunks" Clicked="OnStopChunksClicked"/>
          <HorizontalStackLayout Spacing="8">
            <Button Text="Play" Clicked="OnPlayClicked"/>
            <Button Text="Pause" Clicked="OnPauseClicked"/>
            <Button Text="Seek" Clicked="OnSeekClicked"/>
          </HorizontalStackLayout>
          <Slider x:Name="PlayheadSlider" Minimum="0" Maximum="1" ValueChanged="OnPlayheadChanged"/>
          <Label x:Name="PlayheadLabel" Text="00:00 / 00:00" TextColor="White"/>
          <Label x:Name="ProjectNameLabel" Text="Untitled Project" FontSize="21" TextColor="White"
                 HorizontalTextAlignment="Center"/>
          <Button Text="Add Selected Media to Timeline" Clicked="OnAddClipClicked"/>
        </VerticalStackLayout>
      </Border>

      <Border Grid.Column="2" BackgroundColor="#24272E" StrokeThickness="0" Padding="12">
        <VerticalStackLayout Spacing="10">
          <Label Text="CLIP INSPECTOR" TextColor="White" FontAttributes="Bold"/>
          <Label Text="In point (seconds)" TextColor="White"/>
          <Entry x:Name="InEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Label Text="Out point (seconds)" TextColor="White"/>
          <Entry x:Name="OutEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Button Text="Apply Trim to Selected Clip" Clicked="OnApplyTrimClicked"/>
          <Button Text="Split Selected Clip" Clicked="OnSplitClicked"/>
          <Button Text="Remove Clip" Clicked="OnRemoveClipClicked"/>
          <Label Text="Track (0 = V1)" TextColor="White"/>
          <Entry x:Name="TrackEntry" Text="0" Keyboard="Numeric" TextColor="White"/>
          <Button Text="Move to Track" Clicked="OnMoveTrackClicked"/>
        </VerticalStackLayout>
      </Border>
    </Grid>

    <Border Grid.Row="2" BackgroundColor="#F7F8FA" StrokeThickness="0" Padding="0">
      <Grid RowDefinitions="36,28,*" RowSpacing="0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="12,0" BackgroundColor="#FFFFFF">
          <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
            <Label Text="Main ▾" TextColor="#171C26" FontAttributes="Bold" VerticalTextAlignment="Center"/>
            <Button Text="T" Clicked="OnSubtitleToolClicked" Padding="6,0" BackgroundColor="Transparent" TextColor="#222B35"/>
            <Button Text="✂" Clicked="OnSplitAtPlayheadClicked" Padding="6,0" BackgroundColor="Transparent" TextColor="#222B35"/>
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="1" Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">
            <Button Text="|◀" Clicked="OnTimelineBeginningClicked" Padding="4,0" BackgroundColor="Transparent" TextColor="#20242A"/>
            <Button x:Name="TimelinePlayButton" Text="▶" Clicked="OnTimelinePlayPauseClicked" Padding="8,0" BackgroundColor="#15191F" TextColor="White"/>
            <Label x:Name="TimelineTimeLabel" Text="0:00.00 / 0:00.00" TextColor="#25364B" FontSize="12" VerticalTextAlignment="Center"/>
          </HorizontalStackLayout>
          <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
            <Label Text="Zoom" TextColor="#364152" VerticalTextAlignment="Center"/>
            <Slider x:Name="TimelineZoomSlider" Minimum="1" Maximum="80" Value="4" WidthRequest="130" ValueChanged="OnTimelineZoomChanged"/>
            <Button Text="Fit" Clicked="OnTimelineFitClicked" Padding="8,0" BackgroundColor="#E8EDF3" TextColor="#25364B"/>
            <CheckBox x:Name="RippleCheckBox" Color="#248CF5"/>
            <Label Text="Ripple" TextColor="#364152" VerticalTextAlignment="Center"/>
            <Button Text="Waveform" Clicked="OnBuildWaveformsClicked" Padding="7,0" BackgroundColor="#E8EDF3" TextColor="#25364B"/>
            <Button Text="Ripple Delete" Clicked="OnRippleDeleteClicked" Padding="7,0" BackgroundColor="#E8EDF3" TextColor="#25364B"/>
          </HorizontalStackLayout>
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="26,*" BackgroundColor="#FFFFFF">
          <Label Grid.Column="0" Text="☰" TextColor="#7A8390" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
          <Label Grid.Column="1" Text="Drag clips • trim edges • click ruler to seek" FontSize="10" TextColor="#7C8793" VerticalTextAlignment="Center" Margin="4,0"/>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="26,*" BackgroundColor="#F4F5F7">
          <CollectionView x:Name="TimelineList" IsVisible="False" SelectionMode="Single" SelectionChanged="OnTimelineSelectionChanged" />
          <Grid Grid.Column="0" RowDefinitions="26,60,28,28" BackgroundColor="#F0F2F5">
            <Label Grid.Row="0" Text="◉" TextColor="#77818E" HorizontalTextAlignment="Center"/>
            <Label Grid.Row="1" Text="◉" TextColor="#697685" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
            <Label Grid.Row="2" Text="♫" TextColor="#697685" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
            <Label Grid.Row="3" Text="T" TextColor="#697685" VerticalTextAlignment="Center" HorizontalTextAlignment="Center"/>
          </Grid>
          <ScrollView x:Name="TimelineScroll" Grid.Column="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Always">
            <ScrollView.GestureRecognizers><DropGestureRecognizer AllowDrop="True" Drop="OnMediaDropped"/></ScrollView.GestureRecognizers>
            <controls:TimelineCanvas x:Name="TimelineCanvas" WidthRequest="4000"/>
          </ScrollView>
        </Grid>
      </Grid>
    </Border>

    <VerticalStackLayout Grid.Row="3" Spacing="3">
      <ProgressBar x:Name="ExportProgressBar" Progress="0"/>
      <Label x:Name="StatusLabel" Text="Ready" TextColor="#C9D2DB"/>
    </VerticalStackLayout>
  </Grid>
</ContentPage>
